# --- NieuweVloer + NieuwTerras admin (Vite build-time on Home Server) ---
# Auth/REST MUST go to self-hosted GoTrue: https://api.nieuwevloer.be
# Do not set these to *.supabase.co — that reintroduces login "Load failed".
# Do not commit real keys. Copy this file to .env.local / HS build env.

# Required: self-hosted GoTrue host (default is already correct if omitted)
VITE_SUPABASE_URL=https://api.nieuwevloer.be

# Required: anon/public JWT from the NAS GoTrue project (HS secret store)
VITE_SUPABASE_ANON_KEY=

# Optional: separate NieuwTerras API. Leave empty to use the same NV `leads` table.
VITE_NIEUWTERRAS_API_URL=
VITE_NIEUWTERRAS_ANON_KEY=
VITE_NIEUWTERRAS_LEADS_TABLE=leads

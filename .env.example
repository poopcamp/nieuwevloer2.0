# --- NieuweVloer + NieuwTerras admin (Vite build-time) ---
# Auth and REST MUST go through the Home Server gateway.
# Do not set these to *.supabase.co — that causes login "Load failed".

# NieuweVloer API (GoTrue + PostgREST behind Kong)
VITE_SUPABASE_URL=https://api.nieuwevloer.be
VITE_SUPABASE_ANON_KEY=

# Optional: separate NieuwTerras PostgREST base. Leave empty to read NT
# rows from the same api.nieuwevloer.be `leads` table (source/project_type).
VITE_NIEUWTERRAS_API_URL=
VITE_NIEUWTERRAS_ANON_KEY=
VITE_NIEUWTERRAS_LEADS_TABLE=leads
